+package agit
+
+import (
+	"testing"
+
+	gitwrap "github.com/Satari4545/ai-git/internal/git"
+)
+
+func agitConfigValue(t *testing.T, key string) string {
+	t.Helper()
+
+	value, err := gitwrap.OutputQuiet("config", "--get", key)
+	if err != nil {
+		t.Fatalf("git config --get %s failed: %v", key, err)
+	}
+	return value
+}
+
+func TestConfigCheckoutFeedRoundTrip(t *testing.T) {
+	initTestRepo(t)
+
+	for _, tc := range []struct {
+		arg      string
+		stored   string
+		modeWant string
+	}{
+		{"enable", "true", "enabled"},
+		{"disable", "false", "disabled"},
+		{"prompt", "prompt", "prompt"},
+	} {
+		if err := Config([]string{"checkout-feed", tc.arg}); err != nil {
+			t.Fatalf("Config(checkout-feed %s) failed: %v", tc.arg, err)
+		}
+		if got := agitConfigValue(t, "agit.checkoutFeed"); got != tc.stored {
+			t.Errorf("checkout-feed %s stored %q, want %q", tc.arg, got, tc.stored)
+		}
+		if got := CheckoutFeedMode(); got != tc.modeWant {
+			t.Errorf("checkout-feed %s: mode = %q, want %q", tc.arg, got, tc.modeWant)
+		}
+	}
+}
+
+func TestConfigContextProviderRoundTrip(t *testing.T) {
+	initTestRepo(t)
+
+	if err := Config([]string{"context-provider", "set", "my-provider --json"}); err != nil {
+		t.Fatalf("set failed: %v", err)
+	}
+	if got := agitConfigValue(t, "agit.contextCommand"); got != "my-provider --json" {
+		t.Errorf("stored provider = %q", got)
+	}
+
+	if err := Config([]string{"context-provider", "get"}); err != nil {
+		t.Fatalf("get failed: %v", err)
+	}
+
+	if err := Config([]string{"context-provider", "unset"}); err != nil {
+		t.Fatalf("unset failed: %v", err)
+	}
+	if _, err := gitwrap.OutputQuiet("config", "--get", "agit.contextCommand"); err == nil {
+		t.Error("expected agit.contextCommand to be unset")
+	}
+}
+
+func TestConfigContextTimeout(t *testing.T) {
+	initTestRepo(t)
+
+	if err := Config([]string{"context-timeout", "42"}); err != nil {
+		t.Fatalf("Config(context-timeout) failed: %v", err)
+	}
+	if got := agitConfigValue(t, "agit.contextTimeoutSec"); got != "42" {
+		t.Errorf("stored timeout = %q, want 42", got)
+	}
+}
+
+func TestConfigUnknownArgsShowsUsage(t *testing.T) {
+	initTestRepo(t)
+
+	// Unknown invocations print usage and return nil (no error).
+	if err := Config([]string{"bogus"}); err != nil {
+		t.Errorf("expected nil error for unknown config args, got %v", err)
+	}
+	if err := Config(nil); err != nil {
+		t.Errorf("expected nil error for empty config args, got %v", err)
+	}
+}
diff --git a/internal/agit/notes_test.go b/internal/agit/notes_test.go
new file mode 100644
index 0000000..409b57c
--- /dev/null
+++ b/internal/agit/notes_test.go
@@ -0,0 +1,124 @@
+package agit
+
+import (
+	"encoding/json"
+	"testing"
+
+	gitwrap "github.com/Satari4545/ai-git/internal/git"
+)
+
+// The product writes notes with `git notes --ref=agit add` (commit.go),
+// reads them with `git notes --ref=agit show` (checkout.go, contextlog.go),
+// and pushes them via the notes ref (push.go). These tests lock the shared
+// ref convention: a note written the way commit writes it must be readable
+// the way every reader reads it.
+
+const testNoteJSON = `{
+  "contextID": "ctx_sha256:noteref123",
+  "logicState": {
+    "schemaVersion": "agit.logic-delta.v0",
+    "agentThinking": {"intentSummary": "ref round trip"},
+    "codeReality": {"activeFiles": ["ref.go"]}
+  },
+  "agentContext": {
+    "provider": "codex",
+    "intentSummary": "ref round trip",
+    "decisions": ["keep one ref"]
+  }
+}`
+
+func TestAgitNoteRefRoundTrip(t *testing.T) {
+	dir := initTestRepo(t)
+
+	head := commitFile(t, dir, "ref.go", "package x", "note me")
+	addAgitNote(t, dir, head, testNoteJSON)
+
+	// Read back exactly like checkout.go and contextlog.go do.
+	raw, err := gitwrap.OutputQuiet("notes", "--ref=agit", "show", head)
+	if err != nil {
+		t.Fatalf("reading note failed: %v", err)
+	}
+	if raw == "" {
+		t.Fatal("expected note content, got empty")
+	}
+
+	summary, err := decodeTestNote(raw)
+	if err != nil {
+		t.Fatalf("decoding round-tripped note failed: %v", err)
+	}
+	if summary.ContextID != "ctx_sha256:noteref123" {
+		t.Errorf("ContextID = %q", summary.ContextID)
+	}
+	if summary.Intent != "ref round trip" {
+		t.Errorf("Intent = %q", summary.Intent)
+	}
+	if summary.Provider != "codex" {
+		t.Errorf("Provider = %q", summary.Provider)
+	}
+}
+
+// decodeTestNote extracts the fields these tests assert on without depending
+// on feature code: it mirrors just enough of the note schema.
+func decodeTestNote(raw string) (struct {
+	ContextID string
+	Intent    string
+	Provider  string
+}, error) {
+	var note struct {
+		ContextID string `json:"contextID"`
+		Logic     *struct {
+			Thinking *struct {
+				Intent string `json:"intentSummary"`
+			} `json:"agentThinking"`
+		} `json:"logicState"`
+		Agent *struct {
+			Provider string `json:"provider"`
+		} `json:"agentContext"`
+	}
+	out := struct {
+		ContextID string
+		Intent    string
+		Provider  string
+	}{}
+	if err := json.Unmarshal([]byte(raw), &note); err != nil {
+		return out, err
+	}
+	out.ContextID = note.ContextID
+	if note.Logic != nil && note.Logic.Thinking != nil {
+		out.Intent = note.Logic.Thinking.Intent
+	}
+	if note.Agent != nil {
+		out.Provider = note.Agent.Provider
+	}
+	return out, nil
+}
+
+func TestAgitNoteMissing(t *testing.T) {
+	dir := initTestRepo(t)
+
+	head := commitFile(t, dir, "plain.go", "package x", "no note")
+
+	// Callers treat a missing note as "no context", not a failure.
+	raw, err := gitwrap.OutputQuiet("notes", "--ref=agit", "show", head)
+	if err == nil {
+		t.Error("expected error for missing note, got nil")
+	}
+	if raw != "" {
+		t.Errorf("expected empty output for missing note, got %q", raw)
+	}
+}
+
+func TestAgitNoteRefListsObject(t *testing.T) {
+	dir := initTestRepo(t)
+
+	head := commitFile(t, dir, "listed.go", "package x", "list me")
+	addAgitNote(t, dir, head, testNoteJSON)
+
+	out, err := gitwrap.OutputQuiet("notes", "--ref=agit", "list")
+	if err != nil {
+		t.Fatalf("notes list failed: %v", err)
+	}
+	if out == "" {
+		t.Error("expected notes list to contain the annotated commit")
+	}
+}
